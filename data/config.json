nizationLogo":{"width":"110px","height":"32px","margin":"8px","padding":"3px","borderRadius":"26px"}},"paymentErrorPage":{"image":{"src":"/error-shookru.png"}},"umraFinalStories":{"story1":{"title":"Розыгрыш Умры закончен!","brandLabel":"IslamApp","description":"Благодарим всех, кто участвовал.</br></br> 1 апреля мы подведем итоги и свяжемся с победителями, чтобы они обрели заслуженную награду.","sadakaBadge":"Садака"},"story2":{"totalAmount":"8 873 200 ₽","donationsCount":"26 000","participantsCount":"6 254"},"story3":{"title":"Садака — не только в Рамадан","buttonText":"Помочь сейчас","description":"Рамадан напоминает нам о щедрости, но помощь нуждающимся важна каждый день. Пусть садака станет регулярной привычкой, которая приносит пользу и очищает сердце."}},"closedFundraisers":{"showSearchBar":true,"searchBarContainer":{"padding":"0 0","marginBottom":"20px"}},"donationsFeedPage":{"headerPadding":"36px 20px","showTopSearchBar":false,"showBottomSearchBar":false,"showSearchUnderHeaderOnMobile":true},"paymentSuccessPage":{"image":{"src":"/success-shookru.png"}},"donationDetailsPage":{"image":{"borderRadius":"16px"},"title":{"color":"#000000","fontSize":20,"darkColor":"#ffffff"},"amounts":{"labelFontSize":13,"valueFontSize":17},"amountInput":{"borderRadius":"8px"},"shareButton":{"padding":"13px 24px","borderRadius":"8px","useLiquidGlass":false,"backgroundColor":"#EEE"}},"bankNotInstalledModal":{"modal":{"margin":"12px","borderRadius":"24px","useLiquidGlass":false,"backgroundColor":"#ffffff"}},"paymentConfirmationModal":{"modal":{"margin":"0px","borderRadius":"38px 38px 0 0","useLiquidGlass":false,"backgroundColor":"#ffffff"}}},"fingerprintEnabled":true},"name":null},"tag_style":[{"id":402,"fundraiser_type":{"id":9,"documentId":"yg9oc0vjgwp5mjam1fgvuodf","name":"Мечети"},"img":{"id":1117,"documentId":"dz92vbwautmpdbpyoooe9pg5","url":"https://cdn.shookru.com/moon_shookru_4ed443edeb.svg"}},{"id":403,"fundraiser_type":{"id":16,"documentId":"bqxsr9f39lwmdubjfz8pr4at","name":"Дети"},"img":{"id":1655,"documentId":"shfkqsdy3ik7xr0kr3zys4d2","url":"https://cdn.shookru.com/icon_2_6977ea6cfa.webp"}},{"id":407,"fundraiser_type":{"id":17,"documentId":"prw8loyiwslwsxj8f3pxfgia","name":"Здоровье"},"img":{"id":1656,"documentId":"pn6bbbp0t3dakpwoiipe4666","url":"https://cdn.shookru.com/icon_3_3957f87663.webp"}},{"id":406,"fundraiser_type":{"id":10,"documentId":"obsi8wwtbzj9v37ieludev95","name":"Фонды"},"img":{"id":1313,"documentId":"gvy3tqustbnm8mly34e9i7oy","url":"https://cdn.shookru.com/sun_front_color_ecd50c6d29.svg"}},{"id":408,"fundraiser_type":{"id":18,"documentId":"id2a8qq5ozkwc99o3c9bcijb","name":"Образование"},"img":{"id":1654,"documentId":"p5z4tkq5ss5z4atez7teag0k","url":"https://cdn.shookru.com/icon_1_028027a50c.webp"}},{"id":409,"fundraiser_type":{"id":19,"documentId":"agud5x86jmadde8yn8ugp78q","name":"Строительство"},"img":{"id":1659,"documentId":"ns1jpevaojjerzpn1ysjul4u","url":"https://cdn.shookru.com/icon_726d36f338.webp"}},{"id":469,"fundraiser_type":{"id":15,"documentId":"jnp62cruundpv5em83c5x1vq","name":"Закят"},"img":{"id":1671,"documentId":"gysh54xs5fl1iznbj9r75edg","url":"https://cdn.shookru.com/book_shookru_802fb2a83f.webp"}}],"banner":[{"id":90,"placeholder":"Подпишитесь на Шукру ","redirectUrl":"https://t.me/charity_shookru","image":{"id":1625,"documentId":"zqmmm3zj1ov4yvj42pm4zzmr","url":"https://cdn.shookru.com/tg_6de4cb539a.svg"},"banner_detail":null},{"id":54,"placeholder":"Садака — важное добро","redirectUrl":null,"image":{"id":1616,"documentId":"qn0df8hz32m2qlsr0k2tnhlj","url":"https://cdn.shookru.com/Text_b5ab22c962.webp"},"banner_detail":{"id":2,"documentId":"woc5l60ttqf2m5l0ln5ioi5r","name":null,"text":[{"type":"heading","level":1,"children":[{"text":"Что такое Садака и зачем она нужна?","type":"text"}]},{"type":"paragraph","children":[{"text":"time 3-5 минут","type":"text"}]},{"type":"paragraph","children":[{"text":"Любое имущество, которым располагает человек, является вмененным ему Создателем для определенных целей и с определенными условиями. В основе того, как человек распоряжается своим имуществом, заключается важное проявление веры.","type":"text"}]},{"type":"paragraph","children":[{"text":"","type":"text"}]},{"type":"paragraph","children":[{"text":"Помимо видов расходования на себя и на свою семью и близких, кого человек обязан содержать (нафака), имеется также закят, который представляет собой обязанность по отношению к определенным людям, находящимся в конкретный момент времени в стесненных обстоятельствах (бедные, путники, должники и пр.).","type":"text"}]},{"type":"paragraph","children":[{"text":"","type":"text"}]},{"type":"paragraph","children":[{"text":"Помимо закята, ислам устанавливает и всячески поощряет любую благотворительность, совершаемую верующим из чистых и искренних побуждений.","type":"text"}]},{"type":"paragraph","children":[{"text":"","type":"text"}]},{"type":"paragraph","children":[{"text":"О важности любых благих дел, включая пожертвования, говорится в многочисленных аятах Священного Корана и хадисах.","type":"text"}]},{"type":"heading","level":2,"children":[{"text":"Выделим отдельные смыслы, которые несет в себе садака:","type":"text"}]},{"type":"image","image":{"ext":".webp","url":"https://83b25184-a234-4b1a-abe3-a4735cc5696a.selstorage.ru/img2_9ae7bacb8b.webp","hash":"img2_9ae7bacb8b","mime":"image/webp","name":"img2.webp","size":6.67,"width":750,"height":332,"caption":null,"formats":{"small":{"ext":".webp","url":"https://83b25184-a234-4b1a-abe3-a4735cc5696a.selstorage.ru/small_img2_9ae7bacb8b.webp","hash":"small_img2_9ae7bacb8b","mime":"image/webp","name":"small_img2.webp","path":null,"size":3.28,"width":500,"height":221,"sizeInBytes":3276},"thumbnail":{"ext":".webp","url":"https://83b25184-a234-4b1a-abe3-a4735cc5696a.selstorage.ru/thumbnail_img2_9ae7bacb8b.webp","hash":"thumbnail_img2_9ae7bacb8b","mime":"image/webp","name":"thumbnail_img2.webp","path":null,"size":1.25,"width":245,"height":108,"sizeInBytes":1252}},"provider":"aws-s3","createdAt":"2026-04-08T06:48:47.697Z","updatedAt":"2026-04-08T06:48:47.697Z","previewUrl":null,"alternativeText":"img2.webp","provider_metadata":null},"children":[{"text":"","type":"text"}]},{"type":"heading","level":6,"children":[{"text":"1. Воспитание качества доброты и профилактика накопительства","type":"text"}]},{"type":"paragraph","children":[{"text":"","type":"text"}]},{"type":"paragraph","children":[{"text":"Садака, на первый взгляд, не несет в себе прямую материальную пользу, наоборот, она уменьшает имущество. Но, совершая благотворительность, человек приобретает нечто большее, чем просто материальную выгоду. Он приобретает важные человеческие качества, такие как доброта и сострадание.","type":"text"}]},{"type":"paragraph","children":[{"text":"","type":"text"}]},{"type":"paragraph","children":[{"text":"Более того, он напоминает себе о том, что, согласно исламу, все материальные блага этого мира, как и сама жизнь - временны, и никакое богатство или накопления не приведут человека к вечным благам, кроме как посредством их благого расходования.","type":"text"}]},{"type":"paragraph","children":[{"text":"","type":"text"}]},{"type":"paragraph","children":[{"text":"Поэтому, регулярно совершая пожертвования (садака), верующий проводит профилактику накопительства, о котором говорится в аятах благородного Корана «Страсть к приумножению увлекает вас» (102:1) и «Горе всякому хулителю и обидчику, который копит состояние и пересчитывает его, думая, что богатство увековечит его» (104:1-3).","type":"text"}]},{"type":"paragraph","children":[{"text":"","type":"text"}]},{"type":"paragraph","children":[{"text":"О важных последствиях садака для веры и качеств человека говорится в аяте: «Вы не обретете благочестия, пока не будете расходовать из того, что вы любите, и что бы вы ни расходовали, Аллах ведает об этом» (3:92). Таким образом, правильная садака, совершенная с чистыми намерениями, способствует развитию в верующем человеке такого важного качества, как благочестие.","type":"text"}]},{"type":"image","image":{"ext":".webp","url":"https://83b25184-a234-4b1a-abe3-a4735cc5696a.selstorage.ru/img3_1da2c8b989.webp","hash":"img3_1da2c8b989","mime":"image/webp","name":"img3.webp","size":11.01,"width":750,"height":332,"caption":null,"formats":{"small":{"ext":".webp","url":"https://83b25184-a234-4b1a-abe3-a4735cc5696a.selstorage.ru/small_img3_1da2c8b989.webp","hash":"small_img3_1da2c8b989","mime":"image/webp","name":"small_img3.webp","path":null,"size":5.63,"width":500,"height":221,"sizeInBytes":5628},"thumbnail":{"ext":".webp","url":"https://83b25184-a234-4b1a-abe3-a4735cc5696a.selstorage.ru/thumbnail_img3_1da2c8b989.webp","hash":"thumbnail_img3_1da2c8b989","mime":"image/webp","name":"thumbnail_img3.webp","path":null,"size":2.35,"width":245,"height":108,"sizeInBytes":2352}},"provider":"aws-s3","createdAt":"2026-04-08T05:31:28.526Z","updatedAt":"2026-04-08T05:31:28.526Z","previewUrl":null,"alternativeText":"img3.webp","provider_metadata":null},"children":[{"text":"","type":"text"}]},{"type":"heading","level":6,"children":[{"text":"2. Выгодная сделка","type":"text"}]},{"type":"paragraph","children":[{"text":"","type":"text"}]},{"type":"paragraph","children":[{"text":"Однако ислам говорит и о другой мудрости, заложенной в садаке. Многочисленные коранические аяты и хадисы указывают, что любое доброе дело, включая пожертвования, приносят человеку блага. Более того, в приумноженном виде.\n","type":"text"}]},{"type":"quote","children":[{"text":"«Притчей о тех, кто расходует свое имущество на пути Аллаха, является притча о зерне, из которого выросло семь колосьев, и в каждом колосе — по сто зерен. Аллах увеличивает награду, кому пожелает. Аллах — Объемлющий, Знающий.»\n\nКоран, «Аль-Бакара», аят 261","type":"text"}]},{"type":"paragraph","children":[{"text":"Таким образом, любое расходование своего имущества с правильными намерениями, приводит к многократным благам, неизмеримо большими (700 раз) по сравнению с тем, что могут принести любые инвестиции. В чем могут выражаться эти блага? Для каждого человека это могут быть свойственные только ему ситуации. Появление интересного предложения по работе, уход от возможного ущерба, прибыль от бизнеса, появление новых партнеров и многое другое. Но эти примеры не могут даже приблизиться и к малой доле","type":"text"}]},{"type":"image","image":{"ext":".webp","url":"https://83b25184-a234-4b1a-abe3-a4735cc5696a.selstorage.ru/img4_a93d9b63a3.webp","hash":"img4_a93d9b63a3","mime":"image/webp","name":"img4.webp","size":3.69,"width":750,"height":332,"caption":null,"formats":{"small":{"ext":".webp","url":"https://83b25184-a234-4b1a-abe3-a4735cc5696a.selstorage.ru/small_img4_a93d9b63a3.webp","hash":"small_img4_a93d9b63a3","mime":"image/webp","name":"small_img4.webp","path":null,"size":1.87,"width":500,"height":221,"sizeInBytes":1872},"thumbnail":{"ext":".webp","url":"https://83b25184-a234-4b1a-abe3-a4735cc5696a.selstorage.ru/thumbnail_img4_a93d9b63a3.webp","hash":"thumbnail_img4_a93d9b63a3","mime":"image/webp","name":"thumbnail_img4.webp","path":null,"size":0.78,"width":245,"height":108,"sizeInBytes":782}},"provider":"aws-s3","createdAt":"2026-04-08T05:32:43.078Z","updatedAt":"2026-04-08T05:32:43.078Z","previewUrl":null,"alternativeText":"img4.webp","provider_metadata":null},"children":[{"text":"","type":"text"}]},{"type":"heading","level":6,"children":[{"text":" 3. Избавление от грехов \n","type":"text"}]},{"type":"paragraph","children":[{"text":"\nПомимо вышесказанного, пожертвования обладают еще одним важны свойством - они являются средством очищения от грехов.","type":"text"}]},{"type":"quote","children":[{"text":"Посланник Аллаха, да благословит его Аллах и приветствует, сказал: «Милостыня стирает грехи подобно тому, как вода гасит огонь» (ат-Тирмизи)","type":"text"}]},{"type":"paragraph","children":[{"text":"Это лишь краткий обзор отдельных проявлений мудрости Создателя, заложенных в такой практике, как садака.\nТаким образом, воспитание в себе привычки регулярно совершать пожертвования (садака) — это практика, которая никогда не оставит человека в убытке.","type":"text"}]}],"createdAt":"2026-04-06T12:22:46.019Z","updatedAt":"2026-04-10T06:33:42.351Z","publishedAt":"2026-04-10T06:33:42.317Z","locale":null,"image":[{"id":1598,"documentId":"fmtr71leuv1yym5hbjc3tnhe","url":"https://cdn.shookru.com/Chat_GPT_Image_2_apr_2026_g_00_28_14_2_6856fef679.svg"}]}},{"id":55,"placeholder":"Почему Шукру","redirectUrl":null,"image":{"id":1615,"documentId":"kuw6kcukco0zo8oqlb26rgeg","url":"https://cdn.shookru.com/Text2_6f089ad087.webp"},"banner_detail":{"id":3,"documentId":"pi5jvk4a1httiukp4ywzi4tt","name":null,"text":[{"type":"paragraph","children":[{"text":"Платформа Шукру создана для мусульманского сообщества. Здесь размещаются проверенные сборы от мечетей, благотворительных фондов и инициатив, направленных на помощь верующим и нуждающимся. Наша цель объединить людей вокруг добрых дел и сделать процесс пожертвований простым, удобным и доступным каждому. ","type":"text"}]},{"type":"paragraph","children":[{"text":"","type":"text"}]},{"type":"paragraph","children":[{"text":"Для команды Шукру доверие и репутация самое важное. Мы понимаем ответственность перед каждым жертвователем и стремимся обеспечить честный и целевой сбор средств для действительно нуждающихся людей и проектов.","type":"text"}]},{"type":"paragraph","children":[{"text":"","type":"text"}]},{"type":"paragraph","children":[{"text":"Одним из наших главных принципов является прозрачность. Каждый сбор проходит проверку перед публикацией, а после его завершения публикуется информация о его закрытии. Ознакомиться с завершёнными сборами можно в разделе «Прочее → Закрытые сборы».","type":"text"}]},{"type":"paragraph","children":[{"text":"","type":"text"}]},{"type":"paragraph","children":[{"text":"Сделайте свою садаку сегодня — помогите нуждающимся!  Ваш вклад имеет значение и действительно меняет жизнь.","type":"text"}]}],"createdAt":"2026-04-09T12:42:43.626Z","updatedAt":"2026-04-09T12:42:43.626Z","publishedAt":"2026-04-09T12:42:43.610Z","locale":null,"image":[{"id":1614,"documentId":"sz86bjplfmd8bi1i9j3cp7dg","url":"https://cdn.shookru.com/Frame_2136137879_bf4cf24bfc.svg"}]}}]}